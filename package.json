{
  "name": "dsh-providers-limits",
  "version": "1.0.0",
  "description": "Shows AI provider subscription limits (5h / weekly / monthly) in the DeepSeek Harness composer dock",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "bundle",
    "limits",
    "quota",
    "rate-limits",
    "opencode",
    "zai",
    "anthropic",
    "codex"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/AndrewGanzha/dsh-providers-limits.git"
  },
  "bugs": {
    "url": "https://github.com/AndrewGanzha/dsh-providers-limits/issues"
  },
  "homepage": "https://github.com/AndrewGanzha/dsh-providers-limits#readme",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
